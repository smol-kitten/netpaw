<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NetPaw</AssemblyName>
    <RootNamespace>NetPaw.Tray</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Self-contained builds carry the whole runtime; compressing the bundle roughly halves the exe. Framework-dependent builds are tiny either way. -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <SelfContained>false</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.10.0</Version>
    <Product>NetPaw</Product>
    <Company>smol-kitten</Company>
    <Copyright>MIT</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NetPaw.Core/NetPaw.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="help\*.md" LogicalName="help/%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Opt-in telemetry variant: dotnet publish -p:Telemetry=true -p:TelemetryToken=cattel_… .
       The default build has no TELEMETRY symbol, so TelemetryHost compiles to empty stubs. -->
  <PropertyGroup Condition="'$(Telemetry)' == 'true'">
    <DefineConstants>$(DefineConstants);TELEMETRY</DefineConstants>
    <Product>NetPaw (telemetry build)</Product>
  </PropertyGroup>
  <ItemGroup Condition="'$(Telemetry)' == 'true'">
    <AssemblyMetadata Include="TelemetryToken" Value="$(TelemetryToken)" />
    <AssemblyMetadata Include="TelemetryEndpoint" Value="$(TelemetryEndpoint)" />
  </ItemGroup>
</Project>
