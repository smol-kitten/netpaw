<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>netpaw-cli</AssemblyName>
    <RootNamespace>NetPaw.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <ApplicationIcon>../NetPaw.Tray/netpaw.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Self-contained builds carry the whole runtime; compressing the bundle roughly halves the exe. Framework-dependent builds are tiny either way. -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NetPaw.Core/NetPaw.Core.csproj" />
  </ItemGroup>
</Project>
