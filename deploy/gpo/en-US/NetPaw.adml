<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0">
  <displayName>NetPaw</displayName>
  <description>Policies for the NetPaw static-IP profile tool</description>
  <resources>
    <stringTable>
      <string id="NetPaw">NetPaw</string>
      <string id="WorkAdapter">Pin the work adapter</string>
      <string id="WorkAdapter_Help">Adapter name (alias, e.g. "Ethernet") NetPaw acts on when a profile names none. Users cannot change it while this policy is set.</string>
      <string id="PanelHotkey">Pin the panel hotkey</string>
      <string id="PanelHotkey_Help">Global hotkey that opens the NetPaw panel, e.g. Ctrl+Alt+N. Needs at least one modifier.</string>
      <string id="ConfirmBeforeApply">Always show the command plan before applying</string>
      <string id="ConfirmBeforeApply_Help">Enabled: every change shows the exact netsh commands and needs confirmation. Disabled: never. Not configured: the user decides.</string>
      <string id="RepoUrls">Profile repositories</string>
      <string id="RepoUrls_Help">One index.json URL per line. Optional public key pin per line: https://host/index.json|keyId:base64PublicKey. Entries from these repositories appear as presets/profiles.</string>
      <string id="AllowUserProfiles">Allow users to create their own profiles</string>
      <string id="AllowUserProfiles_Help">Disabled: only managed profiles (from %ProgramData%\NetPaw\profiles.d) are available; the user's profiles.json is ignored.</string>
      <string id="AllowUserRepos">Allow users to add profile repositories</string>
      <string id="AllowUserRepos_Help">Disabled: only repositories from the "Profile repositories" policy are used.</string>
      <string id="AllowReach">Allow reach mode</string>
      <string id="AllowReach_Help">Disabled: typing an IP in the panel and "netpaw-cli reach" are refused (exit code 4).</string>
      <string id="AllowTempAddresses">Allow temporary addresses</string>
      <string id="AllowTempAddresses_Help">Disabled: reach mode may only switch to saved profiles; it never adds an ad-hoc address. Device presets are hidden.</string>
      <string id="AllowDhcp">Allow switching to DHCP</string>
      <string id="AllowDhcp_Help">Disabled: the DHCP button and "netpaw-cli dhcp" are refused.</string>
      <string id="AllowUnsignedRepos">Allow unsigned repositories</string>
      <string id="AllowUnsignedRepos_Help">Disabled: entries from a repository without a valid signature and pinned key are not shown.</string>
      <string id="AllowTelemetry">Allow telemetry (telemetry build only)</string>
      <string id="AllowTelemetry_Help">Disabled: the telemetry build of NetPaw sends nothing, regardless of the user's setting. The standard build never sends telemetry.</string>
      <string id="AllowAutoSwitch">Allow automatic profile switching</string>
      <string id="AllowAutoSwitch_Help">Disabled: profiles never apply themselves on link-up, even if a fingerprint matches.</string>
      <string id="AllowScan">Allow scanning (try profiles / find routers)</string>
      <string id="AllowScan_Help">Disabled: the scan dialog, find-routers and their CLI commands are refused (exit 4).</string>
      <string id="AllowCapture">Allow packet capture (LLDP/CDP via pktmon)</string>
      <string id="AllowCapture_Help">Disabled: NetPaw never starts a pktmon capture; the Switch tab and 'netpaw-cli switch' are refused.</string>
      <string id="AllowUpdateCheck">Allow the daily update check (GitHub releases API)</string>
      <string id="AllowIntentWatch">Allow the intent watcher (unanswered connections → profile advice)</string>
      <string id="AllowIntentWatch_Help">Disabled: NetPaw never reads the local TCP table to spot programs waiting on an unreachable address, and never recommends a profile for it. The watcher sends nothing; it only reads the table on this machine.</string>
      <string id="AllowUpdateCheck_Help">Disabled: NetPaw never contacts api.github.com to look for a newer release. Managed fleets that ship NetPaw through Intune/GPO should disable this.</string>
      <string id="TierItem_StandardUser">Standard user</string>
      <string id="TierItem_NetworkConfigOperators">Network Configuration Operators</string>
      <string id="TierItem_Admin">Administrators</string>
      <string id="Tier_ApplyProfile">Minimum tier to apply a profile</string>
      <string id="Tier_ApplyProfile_Help">Lowest caller tier allowed to apply a profile through the NetPaw service. Not configured: the default (StandardUser).</string>
      <string id="Tier_Dhcp">Minimum tier to switch an adapter to DHCP</string>
      <string id="Tier_Dhcp_Help">Lowest caller tier allowed to switch an adapter to DHCP through the NetPaw service. Not configured: the default (StandardUser).</string>
      <string id="Tier_Reach">Minimum tier to reach mode (temporary address)</string>
      <string id="Tier_Reach_Help">Lowest caller tier allowed to reach mode (temporary address) through the NetPaw service. Not configured: the default (StandardUser).</string>
      <string id="Tier_Renew">Minimum tier to renew a DHCP lease</string>
      <string id="Tier_Renew_Help">Lowest caller tier allowed to renew a DHCP lease through the NetPaw service. Not configured: the default (StandardUser).</string>
      <string id="Tier_ClearTemp">Minimum tier to remove temporary addresses</string>
      <string id="Tier_ClearTemp_Help">Lowest caller tier allowed to remove temporary addresses through the NetPaw service. Not configured: the default (NetworkConfigOperators).</string>
      <string id="Tier_DeleteRoute">Minimum tier to delete a route</string>
      <string id="Tier_DeleteRoute_Help">Lowest caller tier allowed to delete a route through the NetPaw service. Not configured: the default (NetworkConfigOperators).</string>
      <string id="Tier_ResetAdapter">Minimum tier to reset (disable/enable) an adapter</string>
      <string id="Tier_ResetAdapter_Help">Lowest caller tier allowed to reset (disable/enable) an adapter through the NetPaw service. Not configured: the default (NetworkConfigOperators).</string>
      <string id="Tier_Release">Minimum tier to release a DHCP lease</string>
      <string id="Tier_Release_Help">Lowest caller tier allowed to release a DHCP lease through the NetPaw service. Not configured: the default (NetworkConfigOperators).</string>
      <string id="Tier_Prefer">Minimum tier to prefer an adapter (interface metric)</string>
      <string id="Tier_Prefer_Help">Lowest caller tier allowed to prefer an adapter (interface metric) through the NetPaw service. Not configured: the default (NetworkConfigOperators).</string>
      <string id="Tier_SetMtu">Minimum tier to set an adapter MTU</string>
      <string id="Tier_SetMtu_Help">Lowest caller tier allowed to set an adapter MTU through the NetPaw service. Not configured: the default (NetworkConfigOperators).</string>
      <string id="Tier_VirtualUnlock">Minimum tier to target a virtual (non-host-facing) adapter</string>
      <string id="Tier_VirtualUnlock_Help">Lowest caller tier allowed to target a virtual (non-host-facing) adapter through the NetPaw service. Not configured: the default (NetworkConfigOperators). The floor for this action is Network Configuration Operators; a lower setting is raised to it.</string>
    </stringTable>
    <presentationTable>
      <presentation id="WorkAdapter"><textBox refId="WorkAdapter"><label>Adapter name:</label></textBox></presentation>
      <presentation id="PanelHotkey"><textBox refId="PanelHotkey"><label>Hotkey:</label></textBox></presentation>
      <presentation id="RepoUrls"><multiTextBox refId="RepoUrls">Repository index URLs (one per line):</multiTextBox></presentation>
      <presentation id="Tier_ApplyProfile"><dropdownList refId="Tier_ApplyProfile">Minimum tier:</dropdownList></presentation>
      <presentation id="Tier_Dhcp"><dropdownList refId="Tier_Dhcp">Minimum tier:</dropdownList></presentation>
      <presentation id="Tier_Reach"><dropdownList refId="Tier_Reach">Minimum tier:</dropdownList></presentation>
      <presentation id="Tier_Renew"><dropdownList refId="Tier_Renew">Minimum tier:</dropdownList></presentation>
      <presentation id="Tier_ClearTemp"><dropdownList refId="Tier_ClearTemp">Minimum tier:</dropdownList></presentation>
      <presentation id="Tier_DeleteRoute"><dropdownList refId="Tier_DeleteRoute">Minimum tier:</dropdownList></presentation>
      <presentation id="Tier_ResetAdapter"><dropdownList refId="Tier_ResetAdapter">Minimum tier:</dropdownList></presentation>
      <presentation id="Tier_Release"><dropdownList refId="Tier_Release">Minimum tier:</dropdownList></presentation>
      <presentation id="Tier_Prefer"><dropdownList refId="Tier_Prefer">Minimum tier:</dropdownList></presentation>
      <presentation id="Tier_SetMtu"><dropdownList refId="Tier_SetMtu">Minimum tier:</dropdownList></presentation>
      <presentation id="Tier_VirtualUnlock"><dropdownList refId="Tier_VirtualUnlock">Minimum tier:</dropdownList></presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
