      <parentCategory ref="NetPaw" /><supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <enabledValue><decimal value="1" /></enabledValue><disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="AllowDhcp" class="Machine" displayName="$(string.AllowDhcp)" explainText="$(string.AllowDhcp_Help)" key="SOFTWARE\Policies\NetPaw" valueName="AllowDhcp">
