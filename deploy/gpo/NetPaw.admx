    <policy name="Tier_ClearTemp" class="Machine" displayName="$(string.Tier_ClearTemp)" explainText="$(string.Tier_ClearTemp_Help)" presentation="$(presentation.Tier_ClearTemp)" key="SOFTWARE\Policies\NetPaw">
      <parentCategory ref="NetPaw" /><supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
