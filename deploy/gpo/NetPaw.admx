    <policy name="Tier_SetMtu" class="Machine" displayName="$(string.Tier_SetMtu)" explainText="$(string.Tier_SetMtu_Help)" presentation="$(presentation.Tier_SetMtu)" key="SOFTWARE\Policies\NetPaw">
